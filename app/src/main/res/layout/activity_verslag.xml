<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VerslagActivity">

    <!-- Label: Monteur -->
    <TextView
        android:id="@+id/labelMonteur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monteur"
        android:textSize="18sp"
        android:layout_marginTop="64dp"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Input: Monteur -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutMonteur"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/labelMonteur"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextMonteur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Je naam" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Label: Beschrijving -->
    <TextView
        android:id="@+id/labelBeschrijving"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Beschrijving"
        android:textSize="18sp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toBottomOf="@id/layoutMonteur"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Input: Beschrijving -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBeschrijving"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/labelBeschrijving"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextBeschrijving"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Wat zie je?" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Label: Categorie -->
    <TextView
        android:id="@+id/labelCategorie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Categorie"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toBottomOf="@id/layoutBeschrijving"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Input: Categorie -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutCategorie"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/labelCategorie"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextCategorie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bijv. Kabelbreuk" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Terug-knop -->
    <Button
        android:id="@+id/buttonTerugVerslag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Terug"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonSaveVerslag"
        app:layout_constraintHorizontal_bias="1.0" />

    <!-- Opslaan-knop -->
    <Button
        android:id="@+id/buttonSaveVerslag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opslaan"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/buttonTerugVerslag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
