<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MobileMonteurPVBThomasAnjema" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/navy_container</item>
        <item name="colorOnPrimaryContainer">@color/navy</item>

        <item name="colorSecondary">@color/amber</item>
        <item name="colorOnSecondary">@color/navy</item>
        <item name="colorSecondaryContainer">@color/amber_container</item>
        <item name="colorOnSecondaryContainer">@color/navy</item>

        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/danger_container</item>

        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/field_outline</item>
        <item name="android:colorBackground">@color/surface_bg</item>

        <!-- Eigen stijlen voor knoppen en invoervelden -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.OutlinedButton</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <!-- Grote knoppen (56dp), goed te raken met handschoenen -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.App.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.App.DangerButton" parent="Widget.App.OutlinedButton">
        <item name="android:textColor">@color/danger</item>
        <item name="iconTint">@color/danger</item>
        <item name="strokeColor">@color/danger</item>
        <item name="rippleColor">@color/danger_container</item>
    </style>

    <!-- Klein label voor de categorie -->
    <style name="Widget.App.Badge" parent="">
        <item name="android:background">@drawable/bg_category_badge</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/navy</item>
    </style>

    <!-- Afgeronde hoeken voor foto's -->
    <style name="ShapeAppearance.App.Photo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

</resources>
